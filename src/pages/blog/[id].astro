---
import { render } from 'astro:content';
import type { MarkdownInstance } from 'astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedPosts, type BlogPost } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();

	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

interface Props {
	post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const translations = import.meta.glob<MarkdownInstance<Record<string, unknown>> | undefined>('../../translations/blog/*.md', { eager: true });
const ChineseContent = translations[`../../translations/blog/${post.id}.md`]?.Content;
---

<ArticleLayout post={post} hasChinese={Boolean(ChineseContent)}>
	<div data-lang={ChineseContent ? 'en' : undefined} lang="en"><Content /></div>
	{ChineseContent && <div data-lang="zh" lang="zh-CN"><ChineseContent /></div>}
</ArticleLayout>
