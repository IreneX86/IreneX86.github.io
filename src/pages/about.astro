---
import Localized from '../components/Localized.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PixelCloud from '../components/sprites/PixelCloud.astro';
import PixelStar from '../components/sprites/PixelStar.astro';
import { SITE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';

const interests = [
	'Nintendo',
	'Steam',
	'Mobile Games',
	'AI & Other Random Stuff',
];
---

<BaseLayout
	title="About"
	description={SITE.aboutDescription}
>
	<SiteHeader currentPath="/about/" />

	<main id="main-content">
		<div class="about-shell">
			<header class="page-header about-header">
				<div class="about-header-sprites" aria-hidden="true">
					<PixelStar class="about-star-primary" size="sm" variant="sparkle" />
					<PixelStar class="about-star-secondary" size="xs" variant="diamond" />
					<PixelCloud class="about-cloud" size="sm" />
				</div>
				<h1><Localized text="Hello, I'm Irene." /></h1>
				<p><Localized text="I'm a game lover." /></p>
			</header>

			<div class="about-content">
				<section class="about-section" aria-labelledby="interests-heading">
					<h2 class="section-heading" id="interests-heading"><Localized text='Interests' /></h2>
					<ul class="interest-list">
						{interests.map((interest) => <li><Localized text={interest} /></li>)}
					</ul>
				</section>

				<section class="about-section find-me" aria-labelledby="find-me-heading">
					<PixelStar class="find-me-star" size="xs" variant="bright" />
					<h2 class="section-heading" id="find-me-heading"><Localized text='Find me' /></h2>
					<a class="about-github-link" href={SITE.github} rel="me">
						GitHub <span aria-hidden="true">↗</span>
					</a>
				</section>
			</div>
		</div>
	</main>

	<SiteFooter />
</BaseLayout>
