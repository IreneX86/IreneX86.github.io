---
interface Props {
	size?: 'xs' | 'sm' | 'md';
	variant?: 'sparkle' | 'diamond' | 'bright';
	class?: string;
}

const { size = 'sm', variant = 'sparkle', class: className } = Astro.props;
---

<svg
	class:list={['pixel-sprite', `sprite--${size}`, className]}
	viewBox="0 0 16 16"
	aria-hidden="true"
	focusable="false"
	shape-rendering="crispEdges"
>
	{variant === 'sparkle' && (
		<>
			<rect class="star-blue" x="7" y="1" width="2" height="4" />
			<rect class="star-blue" x="7" y="11" width="2" height="4" />
			<rect class="star-blue" x="1" y="7" width="4" height="2" />
			<rect class="star-blue" x="11" y="7" width="4" height="2" />
			<rect class="star-pink" x="5" y="5" width="6" height="6" />
			<rect class="star-light" x="7" y="7" width="2" height="2" />
		</>
	)}
	{variant === 'diamond' && (
		<>
			<rect class="star-lavender" x="7" y="2" width="2" height="2" />
			<rect class="star-lavender" x="5" y="4" width="6" height="2" />
			<rect class="star-pink" x="3" y="6" width="10" height="4" />
			<rect class="star-lavender" x="5" y="10" width="6" height="2" />
			<rect class="star-lavender" x="7" y="12" width="2" height="2" />
			<rect class="star-light" x="7" y="6" width="2" height="2" />
		</>
	)}
	{variant === 'bright' && (
		<>
			<rect class="star-pink" x="7" y="0" width="2" height="5" />
			<rect class="star-pink" x="7" y="11" width="2" height="5" />
			<rect class="star-pink" x="0" y="7" width="5" height="2" />
			<rect class="star-pink" x="11" y="7" width="5" height="2" />
			<rect class="star-lavender" x="5" y="5" width="6" height="6" />
			<rect class="star-light" x="7" y="7" width="2" height="2" />
		</>
	)}
</svg>

<style>
	.pixel-sprite {
		display: block;
		width: var(--sprite-size, var(--sprite-sm));
		height: var(--sprite-size, var(--sprite-sm));
		overflow: visible;
	}

	.sprite--xs { --sprite-size: var(--sprite-xs); }
	.sprite--sm { --sprite-size: var(--sprite-sm); }
	.sprite--md { --sprite-size: var(--sprite-md); }

	.star-blue { fill: var(--pixel-blue); }
	.star-pink { fill: var(--pixel-pink); }
	.star-lavender { fill: var(--pixel-lavender); }
	.star-light { fill: var(--sprite-light); }
</style>
