---
import { SITE } from '../config';

interface Props {
	currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isBlog = currentPath.startsWith('/blog');
const isAbout = currentPath.startsWith('/about');
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="wordmark" href="/" aria-label={`${SITE.title}, home`}>X</a>

		<div class="header-actions">
			<nav class="site-nav" aria-label="Primary navigation">
				<a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
				<a href="/blog/" aria-current={isBlog ? 'page' : undefined}>Blog</a>
				<a href="/about/" aria-current={isAbout ? 'page' : undefined}>About</a>
				<a class="external-link" href={SITE.github} rel="me">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</nav>

			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Change color theme">
				<span class="theme-icon" aria-hidden="true"></span>
				<span class="sr-only" data-theme-value>Light theme</span>
			</button>
		</div>
	</div>
</header>

<script>
	const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const themeValue = themeToggle?.querySelector<HTMLElement>('[data-theme-value]');
	const colorScheme = window.matchMedia('(prefers-color-scheme: dark)');

	const getTheme = () => document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

	const updateControl = (theme: 'light' | 'dark') => {
		if (!themeToggle || !themeValue) return;

		const nextTheme = theme === 'dark' ? 'light' : 'dark';
		themeValue.textContent = `${theme === 'dark' ? 'Dark' : 'Light'} theme`;
		themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
		themeToggle.setAttribute('title', `Switch to ${nextTheme} theme`);
	};

	const applyTheme = (theme: 'light' | 'dark', persist = false) => {
		document.documentElement.dataset.theme = theme;
		document.documentElement.style.colorScheme = theme;
		document
			.querySelector('meta[name="theme-color"]')
			?.setAttribute('content', theme === 'dark' ? '#172331' : '#eef7ff');
		updateControl(theme);

		if (persist) {
			try {
				localStorage.setItem('theme', theme);
			} catch {}
		}
	};

	updateControl(getTheme());

	themeToggle?.addEventListener('click', () => {
		applyTheme(getTheme() === 'dark' ? 'light' : 'dark', true);
	});

	colorScheme.addEventListener('change', (event) => {
		let hasSavedTheme = false;

		try {
			hasSavedTheme = localStorage.getItem('theme') !== null;
		} catch {}

		if (!hasSavedTheme) {
			applyTheme(event.matches ? 'dark' : 'light');
		}
	});
</script>
