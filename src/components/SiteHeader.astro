---
import Localized from '../components/Localized.astro';
import { SITE } from '../config';
import MeowsterLogo from './MeowsterLogo.astro';

interface Props {
	currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isBlog = currentPath.startsWith('/blog');
const isProjects = currentPath.startsWith('/projects');
const isAbout = currentPath.startsWith('/about');
---

<header class="site-header">
	<div class="shell header-inner">
		<MeowsterLogo />

		<div class="header-actions">
			<nav class="site-nav" aria-label="Primary navigation">
				<a href="/" aria-current={currentPath === '/' ? 'page' : undefined}><Localized text='Home' /></a>
				<a href="/blog/" aria-current={isBlog ? 'page' : undefined}><Localized text='Blog' /></a>
				<a href="/projects/" aria-current={isProjects ? 'page' : undefined}><Localized text='Projects' /></a>
				<a href="/about/" aria-current={isAbout ? 'page' : undefined}><Localized text='About' /></a>
				<a class="external-link" href={SITE.github} rel="me">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</nav>

			<button class="language-toggle" type="button" data-language-toggle aria-label="切换到中文">中文</button>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Change color theme">
				<span class="theme-icon" aria-hidden="true"></span>
				<span class="sr-only" data-theme-value><Localized text='Light theme' /></span>
			</button>
		</div>
	</div>
</header>

<script>
	const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const themeValue = themeToggle?.querySelector<HTMLElement>('[data-theme-value]');
	const colorScheme = window.matchMedia('(prefers-color-scheme: dark)');

	const getTheme = () => document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';

	const updateControl = (theme: 'light' | 'dark') => {
		if (!themeToggle || !themeValue) return;

		const nextTheme = theme === 'dark' ? 'light' : 'dark';
		const chinese = document.documentElement.lang === 'zh-CN';
		themeValue.textContent = chinese ? (theme === 'dark' ? '深色主题' : '浅色主题') : `${theme === 'dark' ? 'Dark' : 'Light'} theme`;
		const label = chinese ? `切换到${nextTheme === 'dark' ? '深色' : '浅色'}主题` : `Switch to ${nextTheme} theme`;
		themeToggle.setAttribute('aria-label', label);
		themeToggle.setAttribute('title', label);
	};

	const applyTheme = (theme: 'light' | 'dark', persist = false) => {
		document.documentElement.dataset.theme = theme;
		document.documentElement.style.colorScheme = theme;
		document
			.querySelector('meta[name="theme-color"]')
			?.setAttribute('content', theme === 'dark' ? '#172331' : '#eef7ff');
		updateControl(theme);

		if (persist) {
			try {
				localStorage.setItem('theme', theme);
			} catch {}
		}
	};

	updateControl(getTheme());
	document.addEventListener('languagechange', () => updateControl(getTheme()));

	themeToggle?.addEventListener('click', () => {
		applyTheme(getTheme() === 'dark' ? 'light' : 'dark', true);
	});

	colorScheme.addEventListener('change', (event) => {
		let hasSavedTheme = false;

		try {
			hasSavedTheme = localStorage.getItem('theme') !== null;
		} catch {}

		if (!hasSavedTheme) {
			applyTheme(event.matches ? 'dark' : 'light');
		}
	});
</script>
