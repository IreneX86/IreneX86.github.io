---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
	<div class="project-preview">
		<img
			src={project.image}
			alt={project.imageAlt}
			width={project.imageWidth}
			height={project.imageHeight}
			decoding="async"
		/>
	</div>
	<div class="project-details">
		<h2>{project.title}</h2>
		<p>{project.description}</p>
		<ul class="project-technologies" aria-label="Technologies">
			{project.technologies.map((technology) => <li>{technology}</li>)}
		</ul>
		<div class="project-actions">
			<a class="project-action project-action-primary" href={project.liveUrl}>Play Game</a>
			{project.notesUrl && (
				<a class="project-action project-action-secondary" href={project.notesUrl}>Dev Notes</a>
			)}
			<a class="project-action project-action-secondary" href={project.sourceUrl}>
				Source <span aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
</article>
