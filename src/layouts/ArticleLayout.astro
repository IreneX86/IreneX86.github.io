---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
	estimateReadingTime,
	formatLongDate,
	type BlogPost,
} from '../utils/posts';
import BaseLayout from './BaseLayout.astro';
import PixelStar from '../components/sprites/PixelStar.astro';

interface Props {
	post: BlogPost;
}

const { post } = Astro.props;
const { title, description, publishedDate, updatedDate, tags, test } = post.data;
const readingTime = estimateReadingTime(post.body);
---

<BaseLayout title={title} description={description} type="article">
	<SiteHeader currentPath="/blog/" />

	<main id="main-content">
		<article class="article-shell">
			<header class="article-header">
				<PixelStar class="article-sparkle" size="xs" variant="sparkle" />
				<div class="article-status">
					<time datetime={publishedDate.toISOString()}>{formatLongDate(publishedDate)}</time>
					<span aria-hidden="true">·</span>
					<span>{readingTime} min read</span>
					{test && <span class="test-label">Test</span>}
				</div>

				<h1>{title}</h1>
				<p class="article-description">{description}</p>

				{tags.length > 0 && (
					<ul class="tag-list" aria-label="Tags">
						{tags.map((tag) => <li>{tag}</li>)}
					</ul>
				)}

				{updatedDate && (
					<p class="updated-date">
						Updated <time datetime={updatedDate.toISOString()}>{formatLongDate(updatedDate)}</time>
					</p>
				)}
			</header>

			<div class="prose">
				<slot />
			</div>

			<footer class="article-footer">
				<div class="article-end-marker" aria-hidden="true">
					<PixelStar size="xs" variant="diamond" />
				</div>
				<a href="/blog/">← Back to Blog</a>
			</footer>
		</article>
	</main>

	<SiteFooter />
</BaseLayout>
